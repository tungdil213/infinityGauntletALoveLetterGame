    "@adonisjs/lucid": "^21.2.0",
    "@adonisjs/mail": "^9.2.2",
    "@adonisjs/session": "^7.4.2",
    "@adonisjs/shield": "^8.1.1",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^3.0.0",
    "@inertiajs/react": "^1.2.0",
    "@vinejs/vine": "^2.1.0",
    "better-sqlite3": "^11.1.2",
    "clsx": "^2.1.1",
    "edge.js": "^6.0.2",
    "luxon": "^3.5.0",
    "mjml": "^4.15.3",
