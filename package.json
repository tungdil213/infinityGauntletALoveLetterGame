{
  "name": "infinity-gauntlet-a-love-letter-game",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#app/*": "./src/application/*.js",
    "#controllers/*": "./src/application/controllers/*.js",
    "#middleware/*": "./src/application/middleware/*.js",
    "#providers/*": "./src/application/providers/*.js",
    "#services/*": "./src/application/services/*.js",
    "#types/*": "./src/application/types/*.js",
    "#useCases/*": "./src/application/useCases/*.js",
    "#domain/*": "./src/domain/*.js",
    "#infrastructure/*": "./src/infrastructure/*.js",
    "#adonis/*": "./src/infrastructure/adonis/*.js",
    "#start/*": "./src/infrastructure/adonis/start/*.js",
    "#database/*": "./src/infrastructure/database/*.js",
    "#migrations/*": "./src/infrastructure/database/migrations/*.js",
    "#models/*": "./src/infrastructure/database/models/*.js",
    "#http/*": "./src/infrastructure/http/*.js",
    "#mails/*": "./src/infrastructure/mails/*.js",
    "#persistence/*": "./src/infrastructure/persistence/*.js",
    "#repositories/*": "./src/infrastructure/repositories/*.js",
    "#presentation/*": "./src/presentation/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.7.0",
    "@adonisjs/eslint-config": "^1.3.0",
    "@adonisjs/prettier-config": "^1.3.0",
    "@adonisjs/tsconfig": "^1.3.0",
    "@japa/assert": "^3.0.0",
    "@japa/browser-client": "^2.0.3",
    "@japa/plugin-adonisjs": "^3.0.1",
    "@japa/runner": "^3.1.4",
    "@swc/core": "^1.7.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "hot-hook": "^0.2.6",
    "pino-pretty": "^11.2.1",
    "playwright": "^1.45.2",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.2.3",
    "@adonisjs/core": "^6.12.1",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/inertia": "^1.1.0",
    "@adonisjs/lucid": "^21.1.0",
    "@adonisjs/mail": "^9.2.2",
    "@adonisjs/session": "^7.4.2",
    "@adonisjs/shield": "^8.1.1",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^3.0.0",
    "@inertiajs/react": "^1.2.0",
    "@vinejs/vine": "^2.1.0",
    "better-sqlite3": "^11.1.2",
    "clsx": "^2.1.1",
    "edge.js": "^6.0.2",
    "luxon": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^2.4.0",
    "xstate": "^5.15.0"
  },
  "hotHook": {
    "boundaries": [
      "./src/**/controllers/**/*.ts",
      "./src/**/middleware/*.ts"
    ]
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config"
}
